{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRY-rust",
  "version": "3.0.0",
  "identifier": "com.vry.rank-yoinker",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VALORANT rank yoinker",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true,
        "devtools": false,
        "additionalBrowserArgs": "--js-flags=--max_old_space_size=64,--expose-gc --disable-background-networking --disable-component-update --disable-client-config-fetch --no-default-browser-check --no-first-run --disable-breakpad --disable-crash-reporter --disable-remote-fonts --disable-webgl --disable-webrtc --disable-databases --disable-notifications --disable-geolocation --disable-print-preview --disable-hang-monitor --disable-threaded-scrolling --msWebView2SimulateMemoryPressureWhenInactive --max-decoded-image-size-mb=0 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaRouter,ReadingList,OptimizationGuideModelDownloading,OptimizationHints,EdgeFeedback,msWebView2EnableShoppingFeatures,msWebView2EnableFamilySafety,CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
